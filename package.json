{
  "name": "ai-system",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tests.json",
    "test": "bun test",
    "test:int": "bun --env-file=.env.local --config=bunfig.int.toml test --timeout 30000 .int.test",
    "test:perf": "PERF=1 bun --env-file=.env.local --config=bunfig.perf.toml test --timeout 60000 .perf.int.test config-write.int.test",
    "check:bundle": "turbo run check:bundle",
    "e2e": "playwright test",
    "e2e:chat": "bunx playwright test -c e2e/chat/playwright.config.ts",
    "test:contract:chat": "bun --config=bunfig.contract.toml test --timeout 30000 tests/contract/chat",
    "keys:dev": "bun tools/scripts/src/keys-dev.ts",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun --env-file=.env.local packages/db/src/migrate.ts",
    "db:seed": "bun --env-file=.env.local packages/db/src/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "hub:seed": "bun --env-file=.env.local apps/hub-api/src/modules/seed/seed.ts",
    "mocks": "bun tools/mocks/src/server.ts",
    "mock:quota": "bun --env-file=.env.local tools/mocks/src/quota.ts",
    "contracts:gen": "bun tools/contracts-gen/hub.ts gen",
    "contracts:check": "bun tools/contracts-gen/hub.ts check",
    "check:size": "bun tools/scripts/src/check-size.ts",
    "check:fn": "bun tools/scripts/src/check-fn.ts",
    "db:test:create": "bun --env-file=.env.local packages/db/src/test-db-cli.ts create",
    "db:test:drop": "bun --env-file=.env.local packages/db/src/test-db-cli.ts drop",
    "depcruise": "bun tools/scripts/src/depcruise.ts",
    "test:lock:verify": "bun tools/scripts/src/test-lock.ts verify",
    "test:lock:write": "bun tools/scripts/src/test-lock.ts write",
    "trace": "bun tools/scripts/src/trace.ts",
    "i18n:check": "bun tools/scripts/src/i18n-check.ts",
    "check": "biome ci --changed --no-errors-on-unmatched && bun run check:size && bun run depcruise && bun run i18n:check && bun run check:fn"
  },
  "devDependencies": {
    "@ai/contracts": "workspace:*",
    "@ai/db": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.14",
    "dependency-cruiser": "18.5.0",
    "jose": "6.2.12",
    "lefthook": "2.1.15",
    "postgres": "3.4.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  }
}
