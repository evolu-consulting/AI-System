{
  "name": "ai-system",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tests.json",
    "test": "bun test",
    "check:bundle": "turbo run check:bundle",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@ai/contracts": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.14",
    "dependency-cruiser": "18.5.0",
    "lefthook": "2.1.15",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  }
}
