{
  "name": "ai-system",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "postinstall": "bun tools/scripts/src/setup-hooks.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tests.json",
    "typecheck:host": "turbo run typecheck --filter=!@ai/agent-runtime && tsc -p tsconfig.tests.json",
    "test": "bun test",
    "test:all": "bun tools/scripts/src/test-all.ts",
    "test:int": "bun --env-file=.env.local --config=bunfig.int.toml test --timeout 30000 .int.test",
    "test:int:par": "bun tools/scripts/src/test-int-par.ts",
    "test:e2e:par": "bun tools/scripts/src/test-e2e-par.ts",
    "e2e:lanes": "bun tools/scripts/src/e2e-lane.cli.ts lanes",
    "e2e:reap": "bun tools/scripts/src/e2e-lane.cli.ts reap",
    "test:affected": "bun tools/scripts/src/test-affected.ts",
    "res:check": "bun tools/scripts/src/res-check.ts",
    "log:view": "bun tools/scripts/src/log-view.ts",
    "verify:slice": "bun tools/scripts/src/verify-slice.ts",
    "verify:wave": "bun tools/scripts/src/verify-wave.ts",
    "verify:predeploy": "bun tools/scripts/src/verify-predeploy.ts",
    "verify:prod": "bun tools/scripts/src/verify-prod.ts",
    "slice:new": "bun tools/scripts/src/slice.ts new",
    "slice:pool": "bun tools/scripts/src/slice.ts pool",
    "slice:merge": "bun tools/scripts/src/slice.ts merge",
    "slice:rm": "bun tools/scripts/src/slice.ts rm",
    "openspec:check": "bun tools/scripts/src/openspec.ts check",
    "eval:hub": "bun eval/hub/run.ts",
    "eval:log-format": "bun tools/eval/log-format/run.ts",
    "openspec:pending": "bun tools/scripts/src/openspec.ts pending",
    "openspec:archive": "bun tools/scripts/src/openspec.ts archive",
    "test:frozen": "bun tools/scripts/src/test-frozen.ts",
    "test:perf": "PERF=1 bun --env-file=.env.local --config=bunfig.perf.toml test --timeout 60000 .perf.int.test config-write.int.test",
    "perf:probe": "bun tools/scripts/src/perf-probe.ts run",
    "perf:baseline": "bun tools/scripts/src/perf-probe.ts baseline",
    "perf:compare": "bun tools/scripts/src/perf-probe.ts compare",
    "test:perf:pd": "PERF=1 bun --env-file=.env.local --config=bunfig.perf.toml test --timeout 120000 tests/acceptance/P-d/perf/",
    "check:bundle": "turbo run check:bundle",
    "e2e": "playwright test",
    "e2e:deployed": "powershell -NoProfile -File deploy/prod-sohoptac2/e2e-deployed.ps1",
    "e2e:chat": "bunx playwright test -c e2e/chat/playwright.config.ts",
    "e2e:chat:x2a": "bunx playwright test -c e2e/chat/playwright.x2a.config.ts",
    "e2e:chat:x2b": "bunx playwright test -c e2e/chat/playwright.x2b.config.ts",
    "e2e:chat:x2b2": "bunx playwright test -c e2e/chat/playwright.x2b2.config.ts",
    "e2e:studio": "bunx playwright test -c e2e/studio/playwright.config.ts",
    "e2e:contracts": "bun tools/scripts/src/run-playwright.ts e2e/contracts-web/playwright.config.ts",
    "e2e:n1": "bun tools/scripts/src/run-playwright.ts e2e/N1/playwright.config.ts",
    "e2e:n2": "bun tools/scripts/src/run-playwright.ts e2e/N2/playwright.n2.config.ts",
    "e2e:pd": "bun tools/scripts/src/run-playwright.ts e2e/P-d/playwright.pd.config.ts",
    "e2e:contracts:capture": "bun tools/scripts/src/run-playwright.ts CW_MODE=capture e2e/contracts-web/playwright.config.ts",
    "test:contract:chat": "bun --config=bunfig.contract.toml test --timeout 30000 tests/contract/chat",
    "test:h1:stack": "bun --env-file=.env.local test --timeout 120000 tests/acceptance/H1/stack",
    "test:h2a:stack": "bun --env-file=.env.local test --timeout 120000 tests/acceptance/H2a/stack",
    "test:h2b:stack": "HUB_MAX_CONCURRENT_RUNS=2 bun --env-file=.env.local --config=bunfig.stack.toml test --timeout 120000 tests/acceptance/H2b/stack",
    "test:h2c:stack": "HUB_MAX_CONCURRENT_RUNS=2 HUB_ATTACH_DRIVER=local bun --env-file=.env.local --config=bunfig.stack.toml test --timeout 120000 tests/acceptance/H2c/stack",
    "test:h3a:stack": "HUB_MAX_CONCURRENT_RUNS=2 HUB_ATTACH_DRIVER=local bun --env-file=.env.local --config=bunfig.stack.toml test --timeout 120000 tests/acceptance/H3a/stack",
    "sandbox:image": "bun apps/agent-runtime/sandbox-image/build.ts",
    "test:pc:sandbox": "bun apps/agent-runtime/scripts/run.ts --sandbox \"uv run pytest tests/acceptance/pc/sandbox_check.py\"",
    "test:pb:stack": "bun --env-file=.env.local --config=bunfig.stack.toml test --timeout 300000 tests/acceptance/P-b/pfs2",
    "test:smoke:live": "bun tools/scripts/src/smoke-live.ts",
    "hub:dify-mock": "bun tools/hub-dev/src/dify-mock.ts",
    "done:h2a": "bun --env-file=.env.local tools/scripts/src/done-h2a.ts",
    "done:h2b": "bun --env-file=.env.local tools/scripts/src/done-h2b.ts",
    "done:h2c": "bun --env-file=.env.local tools/scripts/src/done-h2c.ts",
    "done:h3a": "bun --env-file=.env.local tools/scripts/src/done-h3a.ts",
    "done:h3b": "bun --env-file=.env.local tools/scripts/src/done-h3b.ts",
    "done:h4a": "bun --env-file=.env.local tools/scripts/src/done-h4a.ts",
    "done:pa": "bun --env-file=.env.local tools/scripts/src/done-pa.ts",
    "done:pb": "bun --env-file=.env.local tools/scripts/src/done-pb.ts",
    "done:pb2": "bun --env-file=.env.local tools/scripts/src/done-pb2.ts",
    "done:x2a": "bun --env-file=.env.local tools/scripts/src/done-x2a.ts",
    "done:x2b": "bun --env-file=.env.local tools/scripts/src/done-x2b.ts",
    "done:h4b1": "bun --env-file=.env.local tools/scripts/src/done-h4b1.ts",
    "done:h4b2": "bun --env-file=.env.local tools/scripts/src/done-h4b2.ts",
    "done:h4b": "bun --env-file=.env.local tools/scripts/src/done-h4b2.ts",
    "done:pc": "bun --env-file=.env.local tools/scripts/src/done-pc.ts",
    "done:pc2": "bun --env-file=.env.local tools/scripts/src/done-pc2.ts",
    "done:pd1": "bun --env-file=.env.local tools/scripts/src/done-pd1.ts",
    "done:n1": "bun --env-file=.env.local tools/scripts/src/done-n1.ts",
    "done:pd2": "bun --env-file=.env.local tools/scripts/src/done-pd2.ts",
    "done:k1": "bun --env-file=.env.local tools/scripts/src/done-k1.ts",
    "done:x2b2": "bun --env-file=.env.local tools/scripts/src/done-x2b2.ts",
    "done:x1": "bun --env-file=.env.local tools/scripts/src/done-x1.ts",
    "hub:dev": "bun --env-file=.env.local tools/hub-dev/src/dev.ts",
    "done:h1": "bun --env-file=.env.local tools/scripts/src/done-h1.ts",
    "keys:dev": "bun tools/scripts/src/keys-dev.ts",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun --env-file=.env.local packages/db/src/migrate.ts",
    "db:seed": "bun --env-file=.env.local packages/db/src/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "admin:roles-backfill": "bun --env-file=.env.local apps/admin-api/src/modules/app-roles/app-roles-backfill.cli.ts",
    "db:reset:dev": "bun --env-file=.env.local packages/db/src/dev-reset.ts",
    "hub:seed": "bun --env-file=.env.local apps/hub-api/src/modules/seed/seed.ts",
    "hub:seed:fixtures": "bun --env-file=.env.local apps/hub-api/src/modules/seed/seed.tenant-fixtures.ts",
    "seed:dify": "bun --env-file=.env.local tools/scripts/src/seed-dify-live.ts",
    "mocks": "bun tools/mocks/src/server.ts",
    "mock:quota": "bun --env-file=.env.local tools/mocks/src/quota.ts",
    "contracts:gen": "bun tools/contracts-gen/hub.ts gen",
    "contracts:check": "bun tools/contracts-gen/hub.ts check",
    "check:size": "bun tools/scripts/src/check-size.ts",
    "check:case": "bun tools/scripts/src/check-case.ts",
    "check:fn": "bun tools/scripts/src/check-fn.ts",
    "dlc:check": "bun tools/scripts/src/dlc-sync-check.ts",
    "db:test:create": "bun --env-file=.env.local packages/db/src/test-db-cli.ts create",
    "db:test:drop": "bun --env-file=.env.local packages/db/src/test-db-cli.ts drop",
    "depcruise": "bun tools/scripts/src/depcruise.ts",
    "depcruise:affected": "bun tools/scripts/src/depcruise.ts --affected",
    "check:pack-sql": "bun tools/scripts/src/check-pack-sql.ts",
    "check:contract-name": "bun tools/scripts/src/check-contract-name.ts",
    "check:i18n-terms": "bun tools/scripts/src/check-i18n-terms.ts",
    "check:settings-path": "bun tools/scripts/src/check-settings-path.ts",
    "check:i18n-unused": "bun tools/scripts/src/check-i18n-unused.ts",
    "check:app-slots": "bun tools/scripts/src/check-app-slots.ts",
    "check:app-events": "bun tools/scripts/src/check-app-events.ts",
    "check:modules": "bun tools/scripts/src/check-modules.ts",
    "check:date-input": "bun tools/scripts/src/check-date-input.ts",
    "check:shared-limits": "bun tools/scripts/src/check-shared-limits.ts",
    "check:toast": "bun tools/scripts/src/check-toast.ts",
    "check:error-codes": "bun tools/scripts/src/check-error-codes.ts",
    "module:index": "bun tools/scripts/src/module-index.ts",
    "module:new": "bun tools/scripts/src/module-new.ts",
    "flow:shadow-diff": "bun --env-file=.env.local apps/hub-api/scripts/flow-shadow-diff.ts",
    "check:boundaries": "bun tools/scripts/src/check-boundaries.ts",
    "test:lock:verify": "bun tools/scripts/src/test-lock.ts verify",
    "test:lock:write": "bun tools/scripts/src/test-lock.ts write",
    "trace": "bun tools/scripts/src/trace.ts",
    "i18n:check": "bun tools/scripts/src/i18n-check.ts",
    "check": "biome ci --changed --no-errors-on-unmatched && bun run check:size && bun run depcruise && bun run check:pack-sql && bun run check:contract-name && bun run check:app-slots && bun run check:app-events && bun run check:modules && bun run check:boundaries && bun run check:date-input && bun run i18n:check && bun run check:i18n-terms && bun run check:settings-path && bun run check:shared-limits && bun run check:toast && bun run check:i18n-unused --strict && bun run check:error-codes && bun run check:fn",
    "combine:dev": "bun --env-file=.env.local tools/hub-dev/src/combine.ts",
    "demo:flows": "bun --env-file=.env.local tools/scripts/src/seed-cr128-flows.ts",
    "seed:cr113": "bun --env-file=.env.local tools/scripts/src/seed-cr113-samples.ts",
    "pm:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-up.ps1 -SeedDemo",
    "pm:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-down.ps1",
    "pm:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-down.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-up.ps1 -Fresh -SeedDemo"
  },
  "devDependencies": {
    "@ai/contracts": "workspace:*",
    "@ai/db": "workspace:*",
    "@ai/test-kit": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.14",
    "dependency-cruiser": "18.5.0",
    "jose": "6.2.12",
    "lefthook": "2.1.15",
    "postgres": "3.4.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  },
  "patchedDependencies": {
    "postgres@3.4.9": "patches/postgres@3.4.9.patch"
  }
}
