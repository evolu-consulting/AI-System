# =====================================================================================================================
# .env.production.example — mẫu env cho môi trường DEPLOY (test/staging/production). Dev dùng `.env.example` + `keys:dev`.
#
# Cách dùng: chép thành file env của server (vd /etc/ai-system.env, quyền 600), thay mọi giá trị <...>.
# KHÔNG commit file đã điền. Mọi giá trị dưới đây là chỗ giữ, không phải secret thật.
#
# Kiến trúc (5 tiến trình + 3 bản build web tĩnh + Postgres 16 + Redis 7):
#   admin-api   (Bun, :3001)  — đăng nhập /auth + API /admin            bun apps/admin-api/src/server.ts
#   hub-api     (Bun, :4000)  — Chat/Hub API, phục vụ luôn Studio /studio bun apps/hub-api/src/server.ts
#   agent-runtime (Python, Linux/WSL, systemd) — chạy agent Claude CLI + Dify async  apps/agent-runtime/deploy/ai-worker.service
#   admin-web   (tĩnh)  apps/admin-web/dist   — reverse proxy /auth, /admin → admin-api
#   chat-web    (tĩnh)  apps/chat-web/dist    — reverse proxy /auth → admin-api; /conversations /runs /agents /commands
#                                               /attachments /rooms /directory /me /health → hub-api (GET text/html của
#                                               /rooms /directory /me trả index.html — route SPA)
#   studio-web  (tĩnh)  apps/studio-web/dist  — đặt HUB_STUDIO_DIST, Hub phục vụ ở /studio; cùng origin Hub cần
#                                               reverse proxy /auth → admin-api
# Ví dụ tên miền (thay bằng của bạn): admin.example.com, chat.example.com, hub.example.com. Bắt buộc HTTPS.
#
# Thứ tự deploy:
#   1. bun install --frozen-lockfile
#   2. Migrate DB bằng role OWNER:  APP_ENV=production bun --env-file=<file env> packages/db/src/migrate.ts
#      (production KHÔNG áp migration dev ⇒ role admin_api / hub_api / agent_runtime chưa có mật khẩu đăng nhập)
#   3. Đặt mật khẩu 3 role (một lần, psql bằng owner):
#        ALTER ROLE admin_api     WITH LOGIN PASSWORD '<mk-admin-api>';
#        ALTER ROLE hub_api       WITH LOGIN PASSWORD '<mk-hub-api>';
#        ALTER ROLE agent_runtime WITH LOGIN PASSWORD '<mk-agent-runtime>';
#   4. Seed admin đầu tiên:          bun --env-file=<file env> packages/db/src/seed.ts
#      Seed cấu hình Hub (tuỳ chọn): bun --env-file=<file env> apps/hub-api/src/modules/seed/seed.ts
#   5. Build web (biến PUBLIC_* nhúng LÚC BUILD — đổi URL phải build lại):  bun run build
#   6. Chạy admin-api, hub-api bằng `bun --env-file=<file env> apps/<app>/src/server.ts` (dưới systemd/pm2) — PEM một dòng
#      chỉ được dotenv của Bun mở chuỗi \n, đừng nạp file này bằng EnvironmentFile= của systemd cho 2 service Bun.
#      agent-runtime: systemd + /etc/ai-worker.env (chỉ biến AGENT_RT_*, APP_ENV, REDIS_URL, LOG_LEVEL). Rồi reverse proxy + HTTPS.
# Lưu ý vận hành khác: docs/PRODUCTION-NOTES.md.
# =====================================================================================================================

APP_ENV=production
LOG_LEVEL=info

# ---------------------------------------------------------------------------------------------------------------------
# Postgres 16 + Redis 7
# ---------------------------------------------------------------------------------------------------------------------
# Owner: chỉ dùng cho migrate/seed (bước 2–4), KHÔNG đưa cho service đang chạy.
DATABASE_URL=postgres://<owner>:<mk-owner>@<db-host>:5432/ai_system
# Role ứng dụng (NOBYPASSRLS — cách ly tenant bằng RLS). Mật khẩu = bước 3.
ADMIN_API_DATABASE_URL=postgres://admin_api:<mk-admin-api>@<db-host>:5432/ai_system
HUB_DATABASE_URL=postgres://hub_api:<mk-hub-api>@<db-host>:5432/ai_system
AGENT_RT_DATABASE_URL=postgres://agent_runtime:<mk-agent-runtime>@<db-host>:5432/ai_system
REDIS_URL=redis://<redis-host>:6379

# ---------------------------------------------------------------------------------------------------------------------
# Khoá dùng chung (sinh MỘT lần, sao lưu ngoài repo — mất SECRET_MASTER_KEY = mất mọi secret đã lưu, gồm key Dify + 2FA)
# ---------------------------------------------------------------------------------------------------------------------
# JWT RS256 (PEM một dòng, xuống dòng viết \n, đặt trong ngoặc kép). admin-api ký (cần cả 2), hub-api chỉ cần PUBLIC.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem && openssl pkey -in jwt.pem -pubout -out jwt.pub
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<...>\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<...>\n-----END PUBLIC KEY-----\n"
JWT_KID=<chuỗi 1–64 ký tự, vd prod-2026-10>
# 32 byte base64 (44 ký tự, kết thúc '='): openssl rand -base64 32. CHUNG admin-api + hub-api.
SECRET_MASTER_KEY=<base64 32 byte>
# Token dịch vụ admin-api ↔ hub-api (≥ 32 ký tự): openssl rand -base64 36. CHUNG 2 service, chỉ server-side.
HUB_INTERNAL_TOKEN=<≥ 32 ký tự ngẫu nhiên>

# ---------------------------------------------------------------------------------------------------------------------
# Seed admin đầu tiên (chỉ đọc lúc chạy seed, bước 4) — đổi mật khẩu ngay sau lần đăng nhập đầu
# ---------------------------------------------------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=<mật khẩu mạnh>
SEED_ADMIN_EMAIL=<admin@example.com>

# ---------------------------------------------------------------------------------------------------------------------
# admin-api
# ---------------------------------------------------------------------------------------------------------------------
PORT=3001
# Origin 3 web (đúng scheme + host, không dấu / cuối).
CORS_ORIGINS=https://admin.example.com,https://chat.example.com,https://hub.example.com
# Link trong mail (cảnh báo quota, đặt lại mật khẩu).
ADMIN_WEB_URL=https://admin.example.com
# "Chạy thử" lệnh trong Admin gọi Hub nội bộ (mạng nội bộ hoặc HTTPS — token đi dạng Bearer).
ADMIN_HUB_URL=http://127.0.0.1:4000
# SMTP thật (vắng = tắt gửi mail, có cảnh báo lúc khởi động).
SMTP_URL=smtps://<user>:<mk>@<smtp-host>:465
MAIL_FROM="AI System <no-reply@example.com>"

# ---------------------------------------------------------------------------------------------------------------------
# hub-api
# ---------------------------------------------------------------------------------------------------------------------
HUB_PORT=4000
HUB_CORS_ORIGINS=https://chat.example.com,https://admin.example.com,https://hub.example.com
# URL Hub mà Agent Runtime gọi tới (MCP + tải file đính kèm). Production VẮNG ⇒ MCP tắt (agent không gọi được tool Dify).
HUB_PUBLIC_INTERNAL_URL=http://<ip-nội-bộ-hub>:4000
# Studio: đường dẫn TUYỆT ĐỐI tới bản build (bước 5).
HUB_STUDIO_DIST=/srv/ai-system/apps/studio-web/dist
# File đính kèm: driver chỉ `local`; DIR tuyệt đối, chỉ user chạy Hub đọc/ghi, cần sao lưu. Hub KHÔNG quét virus.
HUB_ATTACH_DRIVER=local
HUB_ATTACH_DIR=/srv/ai-system-data/attachments
# Tuỳ chọn (trống = mặc định):
HUB_INSTANCE_ID=
HUB_MAX_CONCURRENT_RUNS=
HUB_JOB_MAX_WAIT_S=
HUB_CONFIG_POLL_S=
HUB_DIFY_TIMEOUT_MAX_S=
HUB_ATTACH_TENANT_MAX_BYTES=
HUB_ATTACH_SWEEP_S=

# ---------------------------------------------------------------------------------------------------------------------
# agent-runtime (Python, chạy dưới user `worker` đã `claude` login — subscription Claude của máy đó)
# Đặt vào /etc/ai-worker.env (xem apps/agent-runtime/deploy/ai-worker.service). Dùng chung APP_ENV, REDIS_URL, LOG_LEVEL.
# ---------------------------------------------------------------------------------------------------------------------
AGENT_RT_PROVIDERS=claude-sub,dify
AGENT_RT_HUB_URL=http://<ip-nội-bộ-hub>:4000
AGENT_RT_WORKER_ID=<tên-máy-worker>
# Tuyệt đối, không nằm dưới /mnt (WSL):
AGENT_RT_WORK_DIR=/home/worker/ai-work
AGENT_RT_LOG_DIR=/home/worker/ai-logs
# Tuỳ chọn (trống = mặc định; giới hạn production xem .env.example):
AGENT_RT_CLI_PATH=
AGENT_RT_PROBE_S=
AGENT_RT_DIFY_READ_TIMEOUT_S=
AGENT_RT_DIFY_STOP_TIMEOUT_S=
AGENT_RT_DIFY_BACKOFF_S=

# ---------------------------------------------------------------------------------------------------------------------
# Build web (bước 5) — nhúng vào bundle, KHÔNG đặt secret ở đây
# ---------------------------------------------------------------------------------------------------------------------
# admin-web
PUBLIC_HUB_URL=https://hub.example.com
PUBLIC_STUDIO_URL=https://hub.example.com/studio/
PUBLIC_CHAT_APP_URL=https://chat.example.com
# studio-web (PUBLIC_AUTH_URL trống = /auth cùng origin Hub — cần reverse proxy /auth → admin-api)
PUBLIC_ADMIN_WEB_URL=https://admin.example.com
PUBLIC_CHAT_WEB_URL=https://chat.example.com
PUBLIC_AUTH_URL=
# chat-web không có biến build: mọi API qua đường dẫn tương đối, reverse proxy lo (xem đầu file).
