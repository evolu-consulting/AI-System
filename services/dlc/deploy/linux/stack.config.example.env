# DLC stack settings for one Linux host. Copy to stack.config.env (next to the scripts, or pass --config) and fill in.
# Plain KEY=value lines (read by bash). No secrets here: passwords and tokens are asked for at run time or
# generated into <INSTALL_ROOT>/secrets (mode 600).

PUBLIC_HOST=203.0.113.10          # the address browsers use; also the Keycloak hostname and the "Start app" links

# system = root install, systemd system units running as SERVICE_USER (recommended for a dedicated server)
# user   = install as the current user, systemd --user units (no root needed; needs lingering: loginctl enable-linger)
SERVICE_MODE=system
SERVICE_USER=dlc                  # system mode: created when missing
INSTALL_ROOT=/opt/dlc             # user mode default: $HOME/dlc

# ports
KEYCLOAK_HTTPS_PORT=8443          # Keycloak MUST be https: its login cookies are 'Secure'
KEYCLOAK_MGMT_PORT=9001           # Keycloak health/management port (Keycloak's own default 9000 is often taken)
KH_PORT=9300                      # knowledge store, bound to 127.0.0.1 only (agents on this host)
ENGINE_PORT=8796                  # DLC engine API + board
FE_PORT=8795                      # default frontend
APP_PORTS=9100-9199               # where completed apps are started ("Start app" button)

# the customer's own frontend, for the 'customer-fe' Keycloak client (edit later in the admin console too)
CUSTOMER_FE_ORIGIN=http://203.0.113.20:3000
CUSTOMER_FE_REDIRECT=http://203.0.113.20:3000/*

# artifacts: folder holding the packages (default: the kit folder, i.e. the parent of kit/)
ARTIFACTS_DIR=
JDK_TAR=OpenJDK21U-jdk_x64_linux_hotspot.tar.gz   # Temurin 21 (Keycloak 26 needs Java 21)
KEYCLOAK_ZIP=keycloak-26.0.7.zip
KH_TAR=KnowledgeHub-linux-x64.tar.gz
DLC_TAR=dlc-0.1.0-linux-x64.tar.gz
FE_TAR=dlc-fe-0.2.0-linux-x64.tar.gz
KH_SIGNING_KEY_FILE=kh-signing-key.pem             # Ed25519 PEM made on the build machine

# engine behaviour (agents only, nobody answers questions)
MAX_PARALLEL_UNITS=3              # builder threads per run (x runs = concurrent agents; keep total <= 10)
MAX_USD_RUN=6
HUMAN_MODE=decide                 # the model decides open questions and logs every decision
# existing code a project may start from (a picked folder or a git clone into it); empty = new projects only.
# The service user must read and write it; every repository must stay inside this folder.
WORKSPACE_ROOT=
