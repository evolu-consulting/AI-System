{
  "pack_id": "kh-default",
  "version": 1,
  "description": "KH default redaction pack: the distil leak gate (config.DISTILL_LEAK_PATTERNS) plus key, credential, phone, IBAN and high-entropy token detection. Every pattern masks.",
  "spec": "Scan each string. Every pattern contributes all non-overlapping matches of re.finditer (Python re semantics, inline flags only). A pattern with min_entropy keeps a match only when the Shannon entropy (bits per character) of the matched text is >= min_entropy. Sort the kept matches by (start, -length, pattern order across the selected packs in selection order); merge overlapping spans (a span starting before the current end extends it) and label a merged span with the name of its first match. Replace each span with [REDACTED:<name>]. A finding of mode refuse refuses the write (422). Masked text scans clean.",
  "patterns": [
    {"name": "email", "kind": "pii", "mode": "mask",
     "regex": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9\\-]+(?:\\.[A-Za-z0-9\\-]+)*\\.[A-Za-z]{2,}"},
    {"name": "assigned_secret", "kind": "secret", "mode": "mask",
     "regex": "(?i:\\b(?:password|passwd|secret|token|api[_-]?key)\\s*[:=]\\s*(?=\\S*\\d)\\S{8,})"},
    {"name": "key_token", "kind": "secret", "mode": "mask",
     "regex": "\\b(?:sk|pk|ghp|gho|xox[bp])[-_][A-Za-z0-9_-]{16,}\\b"},
    {"name": "jwt", "kind": "secret", "mode": "mask",
     "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}(?:\\.[A-Za-z0-9_-]+)?"},
    {"name": "private_key", "kind": "secret", "mode": "mask",
     "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?(?:-----END [A-Z ]*PRIVATE KEY-----|$)"},
    {"name": "aws_access_key", "kind": "secret", "mode": "mask",
     "regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"},
    {"name": "bearer", "kind": "secret", "mode": "mask",
     "regex": "(?i:\\bbearer\\s+)[A-Za-z0-9._~+/-]{20,}=*"},
    {"name": "url_credentials", "kind": "secret", "mode": "mask",
     "regex": "\\b[A-Za-z][A-Za-z0-9+.\\-]*://[^\\s:/@]+:[^\\s@/]+@"},
    {"name": "phone", "kind": "pii", "mode": "mask",
     "regex": "(?<![\\w+])\\+\\d{1,3}[ .\\-]?(?:\\(\\d{1,4}\\)[ .\\-]?)?\\d{2,4}(?:[ .\\-]?\\d{2,4}){1,4}\\b"},
    {"name": "iban", "kind": "pii", "mode": "mask",
     "regex": "\\b[A-Z]{2}\\d{2}(?: ?[A-Z0-9]{4}){2,7}(?: ?[A-Z0-9]{1,3})?\\b"},
    {"name": "high_entropy", "kind": "secret", "mode": "mask", "min_entropy": 4.0,
     "regex": "(?<![A-Za-z0-9+_])(?=[A-Za-z0-9+_]*?[A-Za-z][0-9]+[A-Za-z])[A-Za-z0-9+_]{24,}={0,2}"}
  ],
