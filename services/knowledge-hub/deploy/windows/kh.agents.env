# Knowledge store settings for an AGENT-ONLY install (no people sign in; up to ~10 concurrent agents).
# Copied to <KH folder>\.env by the installer, which appends KH_PRINCIPAL_SIGNING_KEY. Keep this file out of
# version control on the server; only Administrators and SYSTEM can read it.

# server: local only - the DLC engine on the same host is the only caller
KH_HOST=127.0.0.1
KH_PORT=__KH_PORT__
KH_NO_TRAY=1

# storage: local files beside the program (SQLite + vector store + graph); no database server needed
KH_STORE_BACKEND=sqlite
KH_VECTOR_BACKEND=chroma

# access: sign-in off, so the store must stay unreachable from the network (127.0.0.1 above).
# The engine authenticates with its own namespace client (KH-signed tokens), provisioned locally.
KH_AUTH_ISSUER=
KH_API_KEY=
KH_NS_PROVISIONER=local

# embeddings in process (small model, enough for ~10 agents); switch to a separate embed service later if needed
KH_EMBEDDER=local

# graph store memory (agent workloads are small)
KH_KUZU_BUFFER_POOL_MB=512
