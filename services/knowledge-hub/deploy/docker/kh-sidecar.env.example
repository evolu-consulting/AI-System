# kh-sidecar settings. Copy OUTSIDE the repo (it will hold secrets), fill in, pass with --env-file.

# --- KH and its identity service
KH_URL=https://<kh-app-route>
KH_WORKER_KC_TOKEN_URL=https://kh-keycloak.cfapps.br10.hana.ondemand.com/realms/knowledge-hub/protocol/openid-connect/token
# A confidential client with direct access grants only and kh-cli's default scopes (aud kh-api + kh claim),
# like kh-agent-chatbot. The account: a technical user of the knowledge-hub realm with the maintainer role.
KH_WORKER_KC_CLIENT_ID=kh-agent-distill
KH_WORKER_KC_CLIENT_SECRET=
KH_WORKER_USERNAME=
KH_WORKER_PASSWORD=

# --- the model: a Claude subscription token from `claude setup-token` (do not also set ANTHROPIC_API_KEY)
CLAUDE_CODE_OAUTH_TOKEN=
KH_WORKER_MODEL=claude-opus-5-5
KH_WORKER_EFFORT=medium

# --- what and when
# * = every project KH serves to the distiller (KH_DISTILL_PROJECTS on the KH server); or a comma list
KH_WORKER_PROJECTS=*
KH_WORKER_JOBS=distil
# "HH:MM" = every day, "sat 03:00" = once a week; in KH_WORKER_TZ. A run missed while down catches up that day.
KH_WORKER_DISTIL_AT=02:00
KH_WORKER_TZ=Asia/Ho_Chi_Minh

# --- safety: start with ENABLED=1 MODE=dry for a night or two (KH writes nothing), then MODE=on
KH_WORKER_ENABLED=0
KH_WORKER_MODE=dry
# 1 = approve what the run wrote (never policy proposals or shares); 0 = items wait on /home > Lesson learn
KH_WORKER_AUTO_APPROVE=0
KH_WORKER_CAP_RUN_USD=3
KH_WORKER_CAP_MONTH_USD=60
