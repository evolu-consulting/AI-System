# The HANA-enabled Keycloak fork with the KH extension, for the local docker test stack.
# Built from .stage/keycloak (deploy/docker/stage.py); same build options as the BTP assemble.sh.
FROM eclipse-temurin:21-jre

RUN apt-get update && apt-get install -y --no-install-recommends unzip curl && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
COPY keycloak.zip VERSION ./
RUN unzip -q keycloak.zip && mv "keycloak-$(cat VERSION)" keycloak && rm keycloak.zip
COPY providers/ /opt/keycloak/providers/
COPY lib-overrides/ /opt/lib-overrides/
RUN for jar in /opt/lib-overrides/*.jar; do [ -e "$jar" ] && cp "$jar" /opt/keycloak/lib/lib/main/; done; true
RUN /opt/keycloak/bin/kc.sh build --db=hana --health-enabled=true --cache=local

ENV KC_DB=hana \
    KC_HTTP_ENABLED=true \
    KC_HTTP_PORT=8080 \
    KC_LOG_LEVEL=info
EXPOSE 8080
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized"]
