# =============================================================================
# KnowledgeHub — environment configuration
# Copy this file to .env and fill in the values for your environment.
# =============================================================================


# -----------------------------------------------------------------------------
# HTTP server
# Bind address + port for the FastAPI/uvicorn server and the tray links.
# (KH_PORT is also read by the launch preflight to detect a running instance.)
# -----------------------------------------------------------------------------
KH_HOST=0.0.0.0
KH_PORT=8000


# -----------------------------------------------------------------------------
# Graph database — SAP HANA  (primary backend)
# If unreachable at startup, KnowledgeHub falls back to Kùzu automatically.
# -----------------------------------------------------------------------------
HANA_HOST=localhost
HANA_PORT=39041
HANA_USERNAME=SYSTEM
HANA_PASSWORD=

# Schema that will be created/used inside HANA
HANA_SCHEMA=KNOWLEDGE_HUB

# Size of the connection pool (number of concurrent HANA connections)
HANA_POOL_SIZE=5

# Enable TLS for the HANA connection  (true | false)
HANA_ENCRYPT=false

# Name of the HANA Graph Workspace (used for OpenCypher multi-hop queries)
# Requires the SAP HANA Graph Engine license; silently skipped if unavailable.
HANA_GRAPH_WORKSPACE=KH_GRAPH_WORKSPACE


# -----------------------------------------------------------------------------
# Graph database — backend selection + Kùzu fallback
# GRAPH_BACKEND: "auto" (probe HANA, else Kùzu) | "kuzu" (skip the HANA probe —
#   saves a ~4s connect timeout when HANA isn't running) | "hana" (no fallback).
# KUZU_PATH is relative to the directory where KnowledgeHub is started.
# -----------------------------------------------------------------------------
GRAPH_BACKEND=auto
KUZU_PATH=./kuzu_data

# KH_DB_BACKEND: one switch for graph + KH's own tables + vectors.
#   "hana"  = all three on HANA;  "local" = Kùzu + SQLite + Chroma, no HANA probe.
#   A store's own variable (GRAPH_BACKEND, KH_STORE_BACKEND, KH_VECTOR_BACKEND) wins.
# KH_DB_BACKEND=

# Pool and table settings (optional; defaults shown). See docs/cloud-deployment.md.
# HANA_MAX_OVERFLOW=0
# HANA_POOL_RECYCLE=0
# HANA_POOL_TIMEOUT=30
# HANA_GRAPH_POOL_TIMEOUT=10
# HANA_CONNECT_TIMEOUT_MS=0
# HANA_SSL_VALIDATE=true
# KH_SQLITE_TIMEOUT=10
# KH_SQLITE_WAL=true
# KH_GRAPH_TABLE_PREFIX=KH_
# KH_HANA_VEC_COLLECTIONS_TABLE=KH_VEC_COLLECTIONS
# KH_HANA_VEC_ROWS_TABLE=KH_VEC_ROWS
# KH_DOCS_TABLE=kh_docs


# -----------------------------------------------------------------------------
# Vector store — ChromaDB + embedding model
# -----------------------------------------------------------------------------
CHROMA_PATH=./chroma_data

# ChromaDB collection name for entity/source-text embeddings
KH_COLLECTION=knowledge_hub_vectors

# sentence-transformers embedding model (384-dim). Cached under models/ on first
# run. Change only if you re-embed the whole store.
KH_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2


# -----------------------------------------------------------------------------
# RAG pipeline tuning
# -----------------------------------------------------------------------------

# Minimum cosine similarity score to accept a vector search hit  (0.0 – 1.0)
VECTOR_SCORE_THRESHOLD=0.35

# Maximum number of ontology hierarchy hops during graph expansion
ONTOLOGY_HOPS=3

# Word count above which a document is semantically chunked before embedding
CHUNK_WORD_THRESHOLD=200

# Days an event is kept unless its type or namespace manifest says otherwise (cron.retention)
KH_EVENTS_RETENTION_DAYS=180
