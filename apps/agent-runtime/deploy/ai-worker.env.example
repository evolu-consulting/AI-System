# WRK-NFR-04 · Mẫu /etc/ai-worker.env (quyền 0600, chủ root) cho ai-worker.service — plan-runtime §1.4.
# KHÔNG đặt secret thật vào file mẫu này. Giá trị rỗng = dùng mặc định.
APP_ENV=production
LOG_LEVEL=info
# Role agent_runtime (NOBYPASSRLS). Postgres Docker trên Windows, WSL networkingMode=mirrored → localhost.
AGENT_RT_DATABASE_URL=postgres://agent_runtime:<mật-khẩu>@localhost:5432/ai_system
REDIS_URL=redis://localhost:6379
# Mặc định = hostname.
AGENT_RT_WORKER_ID=
# Danh sách provider, phân tách bằng dấu phẩy. fake-cli chỉ cho development|test (production → exit 2).
AGENT_RT_PROVIDERS=claude-sub
# Tuyệt đối, không dưới /mnt.
AGENT_RT_WORK_DIR=/home/worker/work
AGENT_RT_LOG_DIR=/home/worker/logs
AGENT_RT_POLL_S=1
AGENT_RT_HEARTBEAT_S=10
AGENT_RT_ORPHAN_S=60
AGENT_RT_KILL_GRACE_S=3
AGENT_RT_CLEANUP_S=3600
# Tuỳ chọn: đường dẫn CLI Claude (trống = CLI đóng gói trong SDK).
AGENT_RT_CLI_PATH=
