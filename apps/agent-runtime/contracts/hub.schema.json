                "maxItems": 40,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "caps": {
                "type": "string",
                "enum": ["source", "autofix"]
              }
            },
            "required": ["source_id", "key", "kind", "config", "allowlist_union"],
            "additionalProperties": false
          }
