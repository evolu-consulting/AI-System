                      },
                      "url": {
                        "type": "string",
                        "maxLength": 2048
                      },
                      "branch": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "pattern": "^[^-]"
                      },
                      "credential_secret_id": {
                        "default": null,
                        "anyOf": [
