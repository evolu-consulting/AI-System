                            "type": "string",
                            "format": "uuid"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "apply_mode": {
                        "type": "string",
                        "enum": ["pr", "auto_merge", "branch_only"]
                      }
