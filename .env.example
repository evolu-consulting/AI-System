# Env dev mẫu (spec M0 §7). Chép thành .env.local bằng `bun run keys:dev` (tự điền khoá rỗng).
# Không đặt secret thật vào file này. Deploy (test/staging/production): xem `.env.production.example`.
DATABASE_URL=postgres://ai:ai_dev_pw@localhost:5432/ai_system
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
SECRET_MASTER_KEY=
# H4b-1 · khoá secrets của Hub (base64 32 byte, KHÁC SECRET_MASTER_KEY; thiếu/sai/trùng ⇒ hub-api không khởi động). keys:dev tự sinh.
HUB_SECRETS_KEY=
# SMTP (cảnh báo quota, đặt lại mật khẩu). Không đặt = tắt gửi mail (dev không có SMTP; production xem .env.production.example).
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Tuỳ chọn: MAIL_FROM="AI System <no-reply@ai-system.local>"
# Mật khẩu demo-owner (tenant `demo`) khi chạy `scripts/dev-up.ps1 -SeedDemo` trên máy dev; trống ⇒ script tự sinh vào .env.local.
DEMO_OWNER_PW=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Email của platform_admin đầu tiên (tuỳ chọn; dev `initial.sh` đặt admin@evolu.com).
SEED_ADMIN_EMAIL=
# admin-api CORS (X1): admin-web :3000 + chat-web :3100 + studio-web :3200 + contracts-web :3300 (N1).
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200,http://localhost:3300
# X1 (ADM-FR-23): Hub cho "Chạy thử" lệnh trong Admin; dùng chung HUB_INTERNAL_TOKEN bên dưới. Trống → 503 HUB_NOT_CONFIGURED.
ADMIN_HUB_URL=http://localhost:4000
# Góp ý về app → thẻ Trello (cần đủ cả ba, thiếu một = chỉ lưu trong app).
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# TRELLO_FEEDBACK_LIST_ID=
# Gốc admin-web cho link trong mail (cảnh báo quota, đặt lại mật khẩu). Trống = http://localhost:3000.
ADMIN_WEB_URL=
APP_ENV=development
PORT=3001
TEST_DATABASE_URL=postgres://ai:ai_dev_pw@localhost:5432/ai_system_test
# admin-api runtime và test RLS dùng role admin_api (NOBYPASSRLS, spec M1 §4). Giá trị dev, không phải secret.
ADMIN_API_DATABASE_URL=postgres://admin_api:admin_api_dev_pw@localhost:5432/ai_system
TEST_ADMIN_API_DATABASE_URL=postgres://admin_api:admin_api_dev_pw@localhost:5432/ai_system_test
# L1 (#224): admin-api dùng REDIS_URL cho giới hạn đăng nhập — BẮT BUỘC khi APP_ENV=production (thiếu ⇒ không khởi động);
# Redis chết ⇒ login 503 AUTH_UNAVAILABLE (đóng an toàn). Dev để trống ⇒ không giới hạn (có cảnh báo khi khởi động).
REDIS_URL=redis://localhost:6379
# L1: số reverse proxy tin cậy đứng trước admin-api (0 = IP socket, bỏ qua X-Forwarded-For). Sau 1 proxy (Caddy/nginx) ⇒ 1;
# để 0 sau proxy thì mọi người dùng chung một xô IP (30 lượt / 10 phút cho cả công ty).
TRUST_PROXY_HOPS=0
# L1 (tuỳ chọn): trần phép băm mật khẩu đồng thời của admin-api; trống ⇒ số lõi (≥ 2).
# LOGIN_HASH_CONCURRENCY=
JWT_KID=
DIFY_BASE_URL=http://localhost:4010/v1
HUB_BASE_URL=http://localhost:4020
MOCK_TIMEOUT_MS=30000
DIFY_MOCK_PORT=4010
HUB_MOCK_PORT=4020
# K1 (spec §7): mock KnowledgeHub (`bun run mocks`); KH_MOCK_API_KEY = khoá chung `X-KH-Key` (trống = mock-kh-key) — tạo
# secret nền tảng kind `kh_api_key` với giá trị này. Kết nối thứ hai dev/e2e: http://127.0.0.1:4030.
KH_MOCK_PORT=4030
KH_MOCK_API_KEY=

# P-c2 (spec §7): Hub gọi GitHub (mở PR). Chỉ HUB_GITHUB_API_URL là đích egress; pr_url chỉ hiện khi host = HUB_GITHUB_WEB_HOST.
# Cần ĐỒNG THỜI cả hai biến, thiếu một ⇒ Hub không mở được PR. Dev/e2e: trỏ vào mock (`bun run mocks`, http://127.0.0.1:4040).
HUB_GITHUB_API_URL=https://api.github.com
HUB_GITHUB_WEB_HOST=github.com
# Mock GitHub (`bun run mocks`): cổng (4040) và token chấp nhận (trống = ghp-mock-ok; dùng làm PAT của nguồn khi thử với mock).
GITHUB_MOCK_PORT=4040
GITHUB_MOCK_TOKEN=

# Cổng host của compose: đặt trong shell hoặc file .env (compose không đọc .env.local).
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# admin-web (M1). ADMIN_API_URL: đích proxy /auth và /admin của dev server/preview.
# PUBLIC_CHAT_APP_URL: URL Chat App cho trang "Tài khoản của bạn dùng Chat App" (tuỳ chọn; để trống thì ẩn nút).
ADMIN_API_URL=http://localhost:3001
# F1 (CR-095): module admin đóng băng (workflows, commands, transfer, workflow-tools). on|off; mặc định off. Dev/test bật. Xem docs/platform/modules.md.
ADMIN_FROZEN_MODULES=on
# F1 (build-time, cả 3 web): hiện UI module đóng băng (Commands/Workflows/Transfer/Quy trình/Nguồn, phòng, DLC, Cài đặt KH). on|off; mặc định off.
PUBLIC_FROZEN_MODULES=on
PUBLIC_CHAT_APP_URL=
# X1 (build-time; dev mặc định Hub :4000 — K1 UAT Minor 7, thiếu ⇒ admin-web "Chưa cấu hình địa chỉ Hub"): Hub cho tab Agent/Quyền hiệu lực; URL Agent Forge (trống → ẩn nút "⇄ Agent Forge"). `combine:dev` tự đặt.
PUBLIC_HUB_URL=http://localhost:4000
PUBLIC_STUDIO_URL=

# Mock Hub kênh chat (C1, `bun run mocks`). Trống = mặc định trong tools/mocks/src/env.ts.
# MOCK_FAST=1: chờ ÷10 (test/e2e). MOCK_FLOW_IDLE_S: flow nghỉ quá N giây → tin đầu theo kịch bản flow-cold (mặc định 600).
# MOCK_EVENTS_RETENTION_S: giữ sự kiện run sau khi xong, quá hạn → E13 410 EVENTS_EXPIRED (mặc định 600).
MOCK_FAST=
MOCK_FLOW_IDLE_S=
MOCK_EVENTS_RETENTION_S=
# Bộ test contract chat (`bun run test:contract:chat`). HUB_URL trống → tự dựng mock trong tiến trình;
# AUTH_URL trống → dùng HUB_URL. CHAT_CONTRACT_USERS (JSON, trống → user mẫu của mock):
# {"a":{...},"b":{...},"other_tenant":{...},"locked":{...}}, mỗi phần tử {"tenant_key","username","password"}.
HUB_URL=
AUTH_URL=
CHAT_CONTRACT_USERS=
# hub-api (H1, plan §7). Dùng chung REDIS_URL, JWT_PUBLIC_KEY, APP_ENV ở trên. Giá trị dev, không phải secret.
# HUB_DATABASE_URL: role hub_api (NOBYPASSRLS). HUB_INSTANCE_ID trống = hostname:pid. HUB_CORS_ORIGINS: chat-web dev (:3100) + admin-web dev (:3000, H3b R23) + studio-web dev (:3200, H4a), phân cách dấu phẩy; mặc định trong env.ts chỉ chat-web.
HUB_PORT=4000
HUB_DATABASE_URL=postgres://hub_api:hub_api_dev_pw@localhost:5432/ai_system
# R1 · kho tri thức: pool riêng; trống ⇒ HUB_DATABASE_URL (để trống ở dev/e2e: stack test đổi HUB_DATABASE_URL sang DB test).
# Production: role knowledge_api (chỉ SET ROLE knowledge_rw), vd postgres://knowledge_api:knowledge_api_dev_pw@localhost:5432/ai_system
KNOWLEDGE_DATABASE_URL=
# Liên kết KnowledgeHub (đủ URL + KEY + PROJECT mới bật; KEY là secret). KNOWLEDGE_KH_TENANTS: uuid,… hoặc * (trống ⇒ không tenant nào).
KNOWLEDGE_KH_URL=
KNOWLEDGE_KH_KEY=
KNOWLEDGE_KH_PROJECT=
KNOWLEDGE_KH_TENANTS=
# Rerank Claude (on + ANTHROPIC_API_KEY). Đồ thị khi nạp: KNOWLEDGE_GRAPH_AI=on (cần ANTHROPIC_API_KEY) | fake | trống = tắt.
KNOWLEDGE_RERANK=
KNOWLEDGE_GRAPH_AI=
# ai-sub · nhà cung cấp AI client chung (rerank, đồ thị, trích HĐ): subscription (MẶC ĐỊNH ngoài test — gói Claude qua Claude
# Code CLI đã đăng nhập, billing subscription) | api (ANTHROPIC_API_KEY) | off. Ghi đè từng tính năng: AI_PROVIDER_KNOWLEDGE_RERANK,
# AI_PROVIDER_KNOWLEDGE_GRAPH, AI_PROVIDER_CONTRACTS_EXTRACT. Test (APP_ENV/NODE_ENV=test) mặc định off. Trợ lý chat chạy qua
# runtime agent (profile Studio claude-sub-1), không theo biến này.
AI_PROVIDER=
AI_SUB_CLI_PATH=
AI_SUB_CLAUDE_CONFIG_DIR=
AI_SUB_MAX_CONCURRENCY=2
HUB_INSTANCE_ID=
HUB_JOB_MAX_WAIT_S=30
HUB_CONFIG_POLL_S=60
HUB_CORS_ORIGINS=http://localhost:3100,http://localhost:3000,http://localhost:3200
# H2a (plan §8): token dịch vụ `/internal/test-run` (≥ 32 ký tự, tự sinh, không commit); trống → route đó 503. X1: admin-api đọc cùng biến (server-side, không bao giờ vào bundle web).
HUB_INTERNAL_TOKEN=
# H2a (plan §8): URL Hub mà Runtime/CLI gọi được (dựng `mcp.url` = <url>/mcp); hạn tối đa một lời gọi tool Dify.
# Trống: development/test → http://localhost:4000; production → MCP tắt (payload `mcp=null`, cảnh báo lúc khởi động).
HUB_PUBLIC_INTERNAL_URL=http://localhost:4000
HUB_DIFY_TIMEOUT_MAX_S=300
# H2b: số run đang chạy tối đa mỗi user (1–20; trống = 2; sai → hub-api không khởi động). `hub:dev` mặc định 20.
HUB_MAX_CONCURRENT_RUNS=
# H4a (plan §9): bản build Studio (đường dẫn tuyệt đối tới apps/studio-web/dist); Hub phục vụ ở /studio cùng origin.
# Trống → /studio 404 (dev dùng studio-web :3200); có mà thiếu index.html → cảnh báo studio-dist-missing, không mount.
HUB_STUDIO_DIST=
# P-a (CR-056, D15): Process Engine (`!quy-trình`, khối quy trình, /process-defs…). on|off; mặc định off. Dev bật; test/prod tự đặt.
HUB_PROCESS_ENGINE=on
# F1 (CR-095): module đóng băng (quy trình/phòng/nguồn/KH/DLC: route công khai + UI). on|off; mặc định off. Dev/test bật. Xem docs/platform/modules.md.
HUB_FROZEN_MODULES=on
# CR-103: route công khai quy trình off|admin|all (admin = chỉ editor/lượt chạy cho tenant_admin/platform_admin, chat-web vẫn đóng băng).
# Trống ⇒ theo HUB_FROZEN_MODULES (on ⇒ all, off ⇒ off). Prod (sohoptac2) muốn editor quy trình: HUB_PROCESS_ROUTES=admin + HUB_PROCESS_ENGINE=on.
HUB_PROCESS_ROUTES=
# Link chuyển app do hub-api trả: Community "Mở Sổ Hợp Tác" = CONTRACTS_WEB_URL; gốc community-web = COMMUNITY_WEB_URL.
# Vắng ⇒ "/" (về lại bảng tin). `scripts/dev-up.ps1` tự đặt :3300 / :3400.
CONTRACTS_WEB_URL=http://localhost:3300
COMMUNITY_WEB_URL=http://localhost:3400
# K1 (spec §7): origin KnowledgeHub được phép (cách dấu phẩy; https, http chỉ loopback dev/test). Trống: development/test →
# mock KH http://localhost:4030,http://127.0.0.1:4030; production → không lưu được kết nối. TIMEOUT_MS: mỗi lời gọi KH
# (1000–30000, trống = 5000; sai → hub-api không khởi động).
HUB_KH_ALLOWED_ORIGINS=
HUB_KH_TIMEOUT_MS=
# studio-web (H4a spec §7, build-time): URL admin-web cho link "⇄ Admin", "Admin › Workflows", đổi mật khẩu.
# Trống → ẩn các link này (e2e studio E04 cần có giá trị khi build).
PUBLIC_ADMIN_WEB_URL=http://localhost:3000
# studio-web (build-time): link sang Chat; gốc /auth (trống = /auth cùng origin — dev proxy / production reverse proxy).
PUBLIC_CHAT_WEB_URL=
PUBLIC_AUTH_URL=
# H2c (plan §7): file đính kèm. DRIVER chỉ `local` (khác/vắng → hub-api không khởi động). DIR: đường dẫn tuyệt đối
# (dev ví dụ <repo>/.data/attachments — `.data/` đã gitignore; chưa có thì Hub tạo). DIR trống (dev/test) =
# <tmp>/ai-hub-attachments; production bắt buộc. `hub:dev` để trống DIR → thư mục tạm mỗi lần (xoá khi dừng). TENANT_MAX_BYTES: hạn mức mỗi tenant (trống = 5368709120, ≥ 20971520). SWEEP_S: chu kỳ dọn
# file mồ côi (10–86400, trống = 600).
HUB_ATTACH_DRIVER=local
HUB_ATTACH_DIR=
HUB_ATTACH_TENANT_MAX_BYTES=
HUB_ATTACH_SWEEP_S=
# FB1 (HUB-FR-138, core-only): kho FileBox. Đặt HUB_ATTACH_DRIVER=filebox rồi điền 4 biến dưới (DIR bỏ qua).
# URL phải https (trừ loopback), ORG = nhãn tổ chức dùng chung, CA = đường dẫn filebox.crt (tin cert tự ký; cấm tắt kiểm TLS),
# TOKEN = Filebox key (BÍ MẬT — không commit/log). TIMEOUT_MS trống = 30000. Lấy từ D:\AI\Filebox-INTEGRATION\filebox.env.
FILEBOX_URL=
FILEBOX_ORG=
FILEBOX_CA=
FILEBOX_TOKEN=
FILEBOX_TIMEOUT_MS=
LOG_LEVEL=info
# Seed Hub (`hub:seed`, dùng DATABASE_URL owner). Trống = mặc định apps/hub-api/seed, profile mặc định (plan §3.6).
HUB_SEED_DIR=
HUB_SEED_PROFILE=
# HUB_LIVE=1 chỉ bật test smoke claude-sub (test-plan §7.2); runtime không đọc.
HUB_LIVE=
# Test H1: DB riêng (tên kết thúc _test), owner — migrate + fixture. Trống = suy từ TEST_DATABASE_URL.
HUB_TEST_DATABASE_URL=postgres://ai:ai_dev_pw@localhost:5432/ai_system_h1_test

# Agent Runtime Python (PY-03, plan-runtime §1.4). Role agent_runtime (NOBYPASSRLS); giá trị dev, không phải secret.
# Dùng chung APP_ENV, REDIS_URL, LOG_LEVEL; HOME đọc từ môi trường (Settings.home). Trống = mặc định.
# AGENT_RT_PROVIDERS: phân cách dấu phẩy (fake-cli chỉ development|test). AGENT_RT_WORK_DIR: tuyệt đối, không dưới /mnt.
AGENT_RT_DATABASE_URL=postgres://agent_runtime:agent_runtime_dev_pw@localhost:5432/ai_system
AGENT_RT_WORKER_ID=
AGENT_RT_PROVIDERS=claude-sub,fake-cli
AGENT_RT_WORK_DIR=
AGENT_RT_LOG_DIR=
AGENT_RT_POLL_S=
AGENT_RT_HEARTBEAT_S=
AGENT_RT_ORPHAN_S=
AGENT_RT_KILL_GRACE_S=
AGENT_RT_CLEANUP_S=3600
AGENT_RT_CLI_PATH=
# H2c (plan-runtime §2, §7): URL Hub nội bộ — bắt buộc khi có `dify`; job có file đính kèm/`out/` cần nó
# (vắng → job có file `failed attachment`, file `out/` bỏ gửi). Trống = không đặt.
AGENT_RT_HUB_URL=
# Dify async (Runtime): read timeout giây (trống = 30; Dify ping ~10 s), timeout stop best-effort (trống = 2),
# backoff thử lại — danh sách giây phân cách dấu phẩy (trống = 2,8).
AGENT_RT_DIFY_READ_TIMEOUT_S=
AGENT_RT_DIFY_STOP_TIMEOUT_S=
AGENT_RT_DIFY_BACKOFF_S=
# H2b: gom `job.delta` — xả mỗi FLUSH_MS (10–1000, trống = 100) hoặc khi đủ FLUSH_CHARS ký tự (1–4000, trống = 200).
AGENT_RT_DELTA_FLUSH_MS=
AGENT_RT_DELTA_FLUSH_CHARS=
# H3a (plan-runtime §6): probe quota subscription. PROBE_S = chu kỳ giây (mặc định 1200 = 20 phút; 0 = tắt;
# production 60–3600, dev/test 1–3600). LOGGED_OUT_S: chu kỳ thử lại khi logged_out (60; prod 10–600). TIMEOUT_S: hạn
# lượt probe (60; prod 10–300). COOLDOWN_DEFAULT_S: cooldown khi không có giờ reset (1800; prod 60–86400). Trống = mặc định.
AGENT_RT_PROBE_S=
AGENT_RT_PROBE_LOGGED_OUT_S=
AGENT_RT_PROBE_TIMEOUT_S=
AGENT_RT_COOLDOWN_DEFAULT_S=
# P-c1 tự-sửa (ADR-0011, spec §7): container mỗi job. RUNTIME_SANDBOX = off|docker|podman|fake (fake chỉ APP_ENV=test;
# off ⇒ job tự-sửa lỗi `container`). Khởi động: tự kiểm CLI + ảnh + cgroup memory.max; sai ⇒ log sandbox.unavailable, coi như off.
# HOST_WORKDIR (dev): đường `work/` nhìn từ Docker Desktop; trống = đường thật. Trống = mặc định bảng spec §7.
RUNTIME_SANDBOX=off
RUNTIME_SANDBOX_IMAGE=
RUNTIME_SANDBOX_HOST_WORKDIR=
# Trần container: CPUS (2), MEMORY_MB (2048, = swap), PIDS (512), TMP_MB (/tmp tmpfs, 256), DISK_MB (workspace, 4096).
RUNTIME_SANDBOX_CPUS=
RUNTIME_SANDBOX_MEMORY_MB=
RUNTIME_SANDBOX_PIDS=
RUNTIME_SANDBOX_TMP_MB=
RUNTIME_SANDBOX_DISK_MB=
# Thời gian (giây): EXEC_S mỗi lệnh agent (120; agent xin ≤ 600), INSTALL_S pha cài (600), TEST_S chạy lại test (900).
RUNTIME_SANDBOX_EXEC_S=
RUNTIME_SANDBOX_INSTALL_S=
RUNTIME_SANDBOX_TEST_S=
# Số job tự-sửa đồng thời mỗi Runtime (1). Trần snapshot vào workspace: MAX_MB (200), MAX_FILES (20000).
RUNTIME_SANDBOX_MAX=
RUNTIME_AUTOFIX_MAX_MB=
RUNTIME_AUTOFIX_MAX_FILES=
# Test int Python: role agent_runtime trên DB test H1 (cùng DB với HUB_TEST_DATABASE_URL).
AGENT_RT_TEST_DATABASE_URL=postgres://agent_runtime:agent_runtime_dev_pw@localhost:5432/ai_system_h1_test

# N3 · cổng thông báo (ADR-0027). HUB_NOTIFY_MODE: off (mặc định) | fake (dev/e2e, cấm ở production) | live (SMTP nodemailer + Web Push).
# live: MỘT bộ SMTP nền tảng; BÍ MẬT KHÔNG ghi vào file này — đặt SMTP_PASSWORD / VAPID_PRIVATE_KEY trong .env.local (không commit)
# hoặc tạo secret nền tảng `smtp_password` / `vapid_private_key` trong kho secret Hub. HUB_VAPID_PUBLIC_KEY là khoá công khai.
HUB_NOTIFY_MODE=off
HUB_NOTIFY_BASE_URL=http://localhost:3300
# HUB_SMTP_HOST=smtp.gmail.com
# HUB_SMTP_PORT=587
# HUB_SMTP_SECURE=false
# HUB_SMTP_USER=
# HUB_SMTP_FROM=no-reply@example.com
# HUB_VAPID_PUBLIC_KEY=
# HUB_VAPID_SUBJECT=mailto:admin@example.com
